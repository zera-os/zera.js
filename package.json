{
  "name": "@zera-os/zera.js",
  "version": "1.0.2",
  "description": "A ZERA Network JavaScript SDK",
  "main": "dist/index.cjs",
  "react-native": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:fast": "node scripts/build.ts --fast",
    "build:lint": "node scripts/build.ts lint",
    "build:esm": "node scripts/build.ts esm",
    "build:watch": "tsc --watch",
    "dev": "npx tsx --watch src/api/validator/fee-info/examples/fee-info-examples.ts",
    "dev:monitoring": "npx tsx --watch src/shared/monitoring/examples/monitoring-examples.ts",
    "build:clean": "node scripts/build.ts clean",
    "type-check": "node scripts/build.ts type-check",
    "build:compile": "node scripts/build.ts compile",
    "build:validate": "node scripts/build.ts validate",
    "build:validate-bundles": "npx tsx scripts/validate-bundles.ts",
    "test": "npx tsx scripts/custom-test-runner.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "monitoring:examples": "npx tsx src/shared/monitoring/examples/monitoring-examples.ts",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run --reporter=verbose",
    "test:verbose": "vitest run --reporter=verbose",
    "test:clean": "vitest run --reporter=verbose",
    "test:ts": "vitest run",
    "test:ts:all": "vitest run",
    "test:ts:js": "vitest run",
    "test:wallet-creation": "vitest run src/wallet-creation/**/*.test.ts",
    "test:wallet-creation:watch": "vitest src/wallet-creation/**/*.test.ts",
    "test:wallet-creation:coverage": "vitest run --coverage src/wallet-creation/**/*.test.ts",
    "test:coin-txn": "vitest run src/coin-txn/tests/",
    "test:coin-txn:watch": "vitest src/coin-txn/tests/",
    "test:coin-txn:coverage": "vitest run --coverage src/coin-txn/tests/",
    "test:grpc": "vitest run src/grpc/**/*.test.ts",
    "test:grpc:watch": "vitest src/grpc/**/*.test.ts",
    "test:grpc:coverage": "vitest run --coverage src/grpc/**/*.test.ts",
    "test:connectrpc": "vitest run src/grpc/tests/connectrpc-live.test.ts --reporter=verbose",
    "test:connectrpc:watch": "vitest src/grpc/tests/connectrpc-live.test.ts",
    "test:shared": "vitest run src/shared/**/*.test.ts",
    "test:shared:watch": "vitest src/shared/**/*.test.ts",
    "test:shared:coverage": "vitest run --coverage src/shared/**/*.test.ts",
    "test:api": "vitest run src/api/**/*.test.ts src/api/**/test/*.test.ts",
    "test:api:watch": "vitest src/api/**/*.test.ts",
    "test:api:coverage": "vitest run --coverage src/api/**/*.test.ts",
    "update:test-scripts": "npx tsx scripts/update-test-scripts.ts",
    "build:proto": "cd proto && npm run build",
    "build:proto:js": "cd proto && npm run build:js",
    "build:proto:ts": "cd proto && npm run build:ts",
    "build:proto:typescript": "cd proto && npm run build:typescript",
    "build:proto:grpc": "cd proto && npm run build:grpc",
    "proto:install": "cd proto && npm install",
    "proto:clean": "cd proto && npm run clean",
    "proto:example": "cd proto && node example.js",
    "lint": "eslint . --ext .ts,.js,.mjs",
    "lint:fix": "eslint . --ext .ts,.js,.mjs --fix",
    "lint:check": "eslint . --ext .ts,.js,.mjs --max-warnings 10",
    "lint:fix-and-check": "npm run lint:fix && npm run lint:check",
    "lint:src": "eslint src --ext .ts,.js,.mjs",
    "lint:src:fix": "eslint src --ext .ts,.js,.mjs --fix",
    "lint:scripts": "eslint scripts --ext .ts,.js,.mjs",
    "lint:scripts:fix": "eslint scripts --ext .ts,.js,.mjs --fix",
    "prepublishOnly": "echo",
    "deploy": "npx tsx publishing/deploy.ts",
    "deploy:patch": "npx tsx publishing/deploy.ts patch",
    "deploy:minor": "npx tsx publishing/deploy.ts minor",
    "deploy:major": "npx tsx publishing/deploy.ts major",
    "deploy:help": "npx tsx publishing/deploy.ts help",
    "unpublish": "npx tsx publishing/unpublish.ts",
    "deprecate": "npx tsx publishing/deprecate.ts",
    "delete-package": "npx tsx publishing/delete-package.ts",
    "delete-package:fast": "npx tsx publishing/delete-package.ts --fast"
  },
  "keywords": [
    "protobuf",
    "grpc",
    "zera",
    "blockchain",
    "wallet",
    "cryptography"
  ],
  "author": "ZERA Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zera-os/zera.js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/zera-os/zera.js#readme",
  "bugs": {
    "url": "https://github.com/zera-os/zera.js/issues"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "overrides": {
    "text-encoding": "npm:fast-text-encoding@1.0.6"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "glob": "^11.0.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@eslint/js": "^9.37.0",
    "@types/node": "^20.19.21",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "chai": "^6.2.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "minimist": "^1.2.8",
    "mocha": "^11.7.4",
    "tsx": "^4.20.6",
    "typescript": "5.9",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
